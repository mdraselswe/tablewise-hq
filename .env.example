# Copy to .env for local development: cp .env.example .env
# Every variable is validated at startup by apps/api/src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# docker compose up -d db
DATABASE_URL=postgres://tablewise:tablewise@localhost:5433/tablewise
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# At least 32 characters. Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
SESSION_TTL_MINUTES=720

# Behind a reverse proxy (Render, Nginx): trust X-Forwarded-* so secure cookies work.
TRUST_PROXY=false
# Force the Secure cookie flag on or off. Defaults to on in production.
# COOKIE_SECURE=true

# Trading day used for report defaults ("today").
BUSINESS_TIMEZONE=Asia/Dhaka
OUTBOX_POLL_INTERVAL_MS=1000
MIGRATE_ON_BOOT=true
# Seed demo outlets, menu, users and 14 days of sales when the database is empty.
SEED_DEMO_DATA=false

# Production single-container deploy only: serve the built web app from this folder.
# WEB_DIST_DIR=../web/dist
